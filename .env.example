# Copy to .env and fill in. Never commit .env.

# Telegram — create bot via @BotFather, /newbot
TELEGRAM_BOT_TOKEN=
# Your personal chat id — message @userinfobot to find it
TELEGRAM_CHAT_ID=
# Optional admin user id (restricts /watch /mute commands to you)
TELEGRAM_ADMIN_USER_ID=

# Database path (default: ./data/scanner.db)
DB_PATH=./data/scanner.db

# Log level: DEBUG, INFO, WARNING
LOG_LEVEL=INFO

# Optional: eBay Browse API for sold-listings valuation
EBAY_APP_ID=

# BrickLink API (https://www.bricklink.com/v2/api/welcome.page)
BRICKLINK_CONSUMER_KEY=
BRICKLINK_CONSUMER_SECRET=
BRICKLINK_TOKEN=
BRICKLINK_TOKEN_SECRET=

# Reverb (https://www.reverb.com/account/api-keys)
REVERB_TOKEN=

# Polling tempo overrides (seconds). Leave empty to use config defaults.
LIVE_POLL_MIN_SECONDS=180
LIVE_POLL_MAX_SECONDS=300

# Price-drop recheck (hours between sweeps)
RECHECK_INTERVAL_HOURS=6

# Dashboard
DASHBOARD_ENABLED=true
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8765

# Stealth browser
# When true, uses Playwright (via patchright) for sites that block plain HTTP clients.
STEALTH_BROWSER_ENABLED=true
STEALTH_BROWSER_HEADLESS=true
