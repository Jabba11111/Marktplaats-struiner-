# Copy to .env and fill in. Never commit .env.

# Telegram — create bot via @BotFather, /newbot
TELEGRAM_BOT_TOKEN=
# Your personal chat id — message @userinfobot to find it
TELEGRAM_CHAT_ID=
# Optional admin user id (restricts /watch /mute commands to you)
TELEGRAM_ADMIN_USER_ID=

# Database path (default: ./data/scanner.db)
DB_PATH=./data/scanner.db

# Log level: DEBUG, INFO, WARNING
LOG_LEVEL=INFO

# Optional: eBay Browse API for sold-listings valuation
EBAY_APP_ID=

# Polling tempo overrides (seconds). Leave empty to use config defaults.
LIVE_POLL_MIN_SECONDS=180
LIVE_POLL_MAX_SECONDS=300
